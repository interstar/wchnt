# Lander for Pharo 14

*(Thanks to Berkan)*

Fly the ship down to the green pad. **Left / right** rotate, **up** burns
fuel, and **down** starts a fresh flight after landing or crashing. Click the
play area first so it receives the arrow keys.

This is the WCHNT Lander example adapted to Pharo's Morphic frame lifecycle.
Morphic calls `%step`; the target ticks the time object and explicitly updates
the game because this Smalltalk experiment does not yet implement reactive
subscriptions. The game logic, terrain generation, collision checks, HUD, and
drawing remain WCHNT Methods.

## Schema

```
>Keys = Bool/left Bool/right Bool/up Bool/down
Phase = "Flying" | "Landed" | "Crashed"
Game = Planet :Ship Phase/phase Int/score Int/landings $Time Keys @WCHNTMaths/maths
Planet = Int/width Int/height Float/gravity [Segment]/segments Pad @WCHNTMaths/maths
Segment = Float/x1 Float/y1 Float/x2 Float/y2
Pad = Float/x Float/y Float/width
Ship = Float/x Float/y Float/vx Float/vy Float/angle Float/fuel Bool/burning @WCHNTMaths/maths
Time = Int/t
Build = Float/px Float/py [Segment]/segs
```

## Construction

```
[:Game
  [:Planet 800 600 0.016
    [:Array/Segment
      [:Segment 0.0 470.0 70.0 430.0]
      [:Segment 70.0 430.0 130.0 500.0]
      [:Segment 130.0 500.0 200.0 480.0]
      [:Segment 200.0 480.0 260.0 540.0]
      [:Segment 260.0 540.0 330.0 520.0]
      [:Segment 330.0 520.0 400.0 520.0]
      [:Segment 400.0 520.0 470.0 470.0]
      [:Segment 470.0 470.0 540.0 500.0]
      [:Segment 540.0 500.0 610.0 440.0]
      [:Segment 610.0 440.0 680.0 490.0]
      [:Segment 680.0 490.0 740.0 460.0]
      [:Segment 740.0 460.0 800.0 510.0]
    ]
    [:Pad 330.0 520.0 70.0]
    maths
  ]
  [:Ship 120.0 90.0 0.8 0.0 0.0 100.0 false maths]
  Flying
  0
  0
  [:Time 0]
  [:Keys false false false false]
  maths
]
```

## Methods

```
Time::update! = { [:Time (t + 1)] }

Keys::update! = { [:Keys left right up down] }

Segment::heightAt = { Float/px, Float/fallback |
  if ((px >= x1) and (px < x2)) {
    y1 + ((y2 - y1) * ((px - x1) / ((x2 - x1) + 0.0001)))
  } else { fallback }
}

Planet::heightAt = { Float/px |
  segments.fold(600.0, { Float/acc, Segment/s | s.heightAt(px, acc) })
}

Planet::onPad = { Float/px | (px >= pad.x) and (px <= (pad.x + pad.width)) }

Planet::roll = {
  padX = 120.0 + (maths.rand() * 500.0).
  padY = 440.0 + (maths.rand() * 100.0).
  built = 12.times({ i | i }).fold([:Build 0.0 (420.0 + (maths.rand() * 120.0)) [:Array/Segment]], { Build/b, Int/i |
    nx = (i + 1) * 66.7.
    ny = if ((nx > padX) and (nx < (padX + 140.0))) { padY } else { 400.0 + (maths.rand() * 160.0) }.
    [:Build nx ny b.segs.cons([:Segment b.px b.py nx ny])]
  }).
  [:Planet width height gravity built.segs [:Pad (padX + 5.0) padY 70.0] maths]
}

Ship::step = { Keys/k |
  turn = (if (k.left) { (0.0 - 0.06) } else { 0.0 }) + (if (k.right) { 0.06 } else { 0.0 }).
  nangle = angle + turn.
  firing = k.up and (fuel > 0.0).
  power = if (firing) { 0.055 } else { 0.0 }.
  gravity = theGame.planet.gravity.
  w = theGame.planet.width * 1.0.
  nvx = vx + (maths.sin(nangle) * power).
  nvy = (vy - (maths.cos(nangle) * power)) + gravity.
  nfuel = if (firing) { fuel - 0.2 } else { fuel }.
  [:Ship ((x + nvx + w) % w) (y + nvy) nvx nvy nangle nfuel firing maths]
}

Ship::gentle = {
  (maths.abs(vx) < 1.5) and (vy < 2.0) and (maths.abs(angle) < 0.4)
}

Ship::fmt = { Float/v |
  tenths = maths.floor((maths.abs(v) * 10.0) + 0.5).
  whole = tenths / 10.
  frac = tenths % 10.
  sign = if (v < (0.0 - 0.05)) { "-" } else { "" }.
  "{sign}{whole}.{frac}".tpl({String:String
    "sign": sign, "whole": whole.str(), "frac": frac.str()})
}

Ship::readout = {
  rfuel = maths.round(fuel).
  "fuel {fuel}   vx {vx}   vy {vy}   tilt {tilt}".tpl({String:String
    "fuel": rfuel.str(), "vx": this.fmt(vx), "vy": this.fmt(vy), "tilt": this.fmt(angle)})
}

Game::newShip = { [:Ship 120.0 90.0 0.8 0.0 0.0 100.0 false maths] }

Game::update! = {
  restart = (phase != Flying) and keys.down.
  moved = if (phase == Flying) { ship.step(keys) }
    (restart) { this.newShip() }
    else { ship }.
  land = if (restart) { planet.roll() } else { planet }.
  ground = land.heightAt(moved.x).
  touching = (phase == Flying) and ((moved.y + 12.0) >= ground).
  nextPhase = if (restart) { Flying }
    (not touching) { phase }
    (land.onPad(moved.x) and moved.gentle()) { Landed }
    else { Crashed }.
  justLanded = (phase == Flying) and (nextPhase == Landed).
  bonus = if (justLanded) { 100 + maths.round(moved.fuel) } else { 0 }.
  more = if (justLanded) { 1 } else { 0 }.
  [:Game land moved nextPhase (score + bonus) (landings + more) time keys maths]
}

Game::banner = {
  switch (phase)
    Landed -> { "THE EAGLE HAS LANDED   (down: fly again)" }
    Crashed -> { "CRATER   (down: fly again)" }
    else -> { "" }
}

Game::scoreLine = {
  "score {score}   landings {landings}".tpl({String:String
    "score": score.str(), "landings": landings.str()})
}

Planet::draw = { @WCHNTGraphics/g |
  ground = segments.fold(g.lineStyle(2, 11184810), { acc, Segment/s | acc.drawLine(s.x1, s.y1, s.x2, s.y2) }).
  g.lineStyle(4, 5232783).drawLine(pad.x, pad.y, pad.x + pad.width, pad.y)
}

Game::draw = { @WCHNTGraphics/g |
  hull = switch (phase)
    Crashed -> { 14428979 }
    Landed -> { 5232783 }
    else -> { 3556687 }.
  planetDrawn = planet.draw(g).
  ship.draw(g, hull)
}

Ship::draw = { @WCHNTGraphics/g, Int/hull |
  c = maths.cos(angle).
  s = maths.sin(angle).
  noseX = x + (s * 14.0).
  noseY = y - (c * 14.0).
  leftX = (x - (c * 10.0)) - (s * 10.0).
  leftY = (y - (s * 10.0)) + (c * 10.0).
  rightX = (x + (c * 10.0)) - (s * 10.0).
  rightY = (y + (s * 10.0)) + (c * 10.0).
  flameLen = if (burning) { 18.0 + (maths.rand() * 12.0) } else { 0.0 }.
  flameX = x - (s * flameLen).
  flameY = y + (c * flameLen).
  g.lineStyle(1, 16750899, (if (burning) { 0.9 } else { 0.0 }))
   .beginFill(16750899, (if (burning) { 0.9 } else { 0.0 }))
   .moveTo((x - (c * 5.0)) - (s * 8.0), (y - (s * 5.0)) + (c * 8.0))
   .lineTo(flameX, flameY)
   .lineTo((x + (c * 5.0)) - (s * 8.0), (y + (s * 5.0)) + (c * 8.0))
   .lineTo((x - (c * 5.0)) - (s * 8.0), (y - (s * 5.0)) + (c * 8.0))
   .endFill()
   .lineStyle(2, 15132390)
   .beginFill(hull)
   .moveTo(noseX, noseY)
   .lineTo(leftX, leftY)
   .lineTo(rightX, rightY)
   .lineTo(noseX, noseY)
   .endFill()
}
```


## Target

```
%smalltalk
%prefix WCHNT

%init
| game |
game := WCHNTGameAssemblage new factoryWithMaths: wchntMaths.
wchntGraphics input: wchntInput; extent: 800@600; background: 16r0005070D alpha: 1.0.

%step
game keys inject: (wchntInput keyDown: 'ArrowLeft')
    with: (wchntInput keyDown: 'ArrowRight')
    with: (wchntInput keyDown: 'ArrowUp')
    with: (wchntInput keyDown: 'ArrowDown').
game time updateMutates.
game updateMutates.
wchntGraphics clear.
game draw: wchntGraphics.
wchntGraphics noStroke.
wchntGraphics beginFill: 16r00D8DEE9.
wchntGraphics fillText: (game ship readout) x: 12 y: 12.
wchntGraphics fillText: (game scoreLine) x: 12 y: 34.
wchntGraphics fillText: (game banner) x: 12 y: 64.
wchntGraphics endFill.
```
