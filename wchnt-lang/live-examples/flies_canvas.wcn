# Flies on the wall (canvas)

Curve-mode chase with a small HUD. Press 1, 2, or 3 to switch mode:

- **1 chase** — each fly follows the fly `follow` steps ahead.
- **2 surprise** — every fly chases the mouse.
- **3 steer** — arrow keys move fly 0; the rest chase it.

`Wall::step` takes the current pointer and held arrow input as arguments. The
discrete mode-selection keys arrive through an `Inbox` and are folded by WCHNT.

## Schema

```
Wall = [Fly]/flies Int/follow Inbox @WCHNTMaths/maths
Fly = Float/x Float/y String/col Bool/live
>Inbox = [String]/keys
```

## Construction

```
[:Wall [:Array/Fly] 2 [:Inbox [:Array/String]] maths]
```

## Methods

```
Fly::move = { Fly/t |
  dx = t.x - x.
  dy = t.y - y.
  adx = if (dx < 0.0) { -dx } else { dx }.
  ady = if (dy < 0.0) { -dy } else { dy }.
  if (not live) {
    [:Fly x y col false]
  } ((adx < 2.0) and (ady < 2.0)) {
    [:Fly x y col false]
  } else {
    steps = if (adx > ady) { adx } else { ady }.
    xinc = if (dx == 0.0) { 0.0 } else { dx / steps }.
    yinc = if (dy == 0.0) { 0.0 } else { dy / steps }.
    [:Fly (x + xinc) (y + yinc) col true]
  }
}

Fly::steer = { Float/udx, Float/udy |
  [:Fly (x + udx) (y + udy) col true]
}

Wall::mode = {
  inbox.keys.fold(1, { current, key |
    switch (key)
      "1" -> { 1 }
      "2" -> { 2 }
      "3" -> { 3 }
      else -> { current }
  })
}

Wall::step = { Float/mx, Float/my, Float/udx, Float/udy |
  mode = this.mode().
  n = flies.length().
  moved = n.times({ i |
    f = flies.get(i).
    j = ((i + follow + n) % n).
    target = switch (mode)
      2 -> { [:Fly mx my "white" true] }
      3 -> { flies.get(0) }
      else -> { flies.get(j) }.
    if ((mode == 3) and (i == 0)) {
      f.steer(udx, udy)
    } else {
      f.move(target)
    }
  }).
  [:Wall moved follow inbox maths]
}

Wall::aliveCount = { flies.fold(0, { acc, f | if (f.live) { acc + 1 } else { acc } }) }

Wall::init = {
  cols = [:Array/String "red" "green" "blue" "white"].
  moved = 12.times({ i |
    a = ((2.0 * maths.pi()) * i) / 12.0.
    fx = 400.0 + (maths.cos(a) * 250.0).
    fy = 300.0 + (maths.sin(a) * 250.0).
    c = cols.get(i % 4).
    [:Fly fx fy c true]
  }).
  [:Wall moved follow inbox maths]
}
```

## Target

```
%canvas

%requires
WCHNTGraphics
WCHNTMaths::sin(Float) -> Float
WCHNTMaths::cos(Float) -> Float
WCHNTMaths::pi() -> Float

%init
var wall;
var colors = {red: 0xff4444, green: 0x44cc44, blue: 0x4488ff, white: 0xffffff};

function drawHud() {
    var mode = wall.mode();
    wchntGraphics.noStroke();
    wchntGraphics.beginFill(0x111111);
    wchntGraphics.drawRect(0, 0, 800, 56);
    wchntGraphics.endFill();
    wchntGraphics.beginFill(0xffffff);
    wchntGraphics.fillText("1 chase   2 surprise   3 steer", 12, 18);
    wchntGraphics.fillText("mode " + mode, 12, 40);
    wchntGraphics.endFill();
}

function init() {
    wall = WallAssemblage.factory(wchntMaths).init();
    wchntGraphics.background(0x111111);
    wchntGraphics.clear();
    wchntGraphics.lineStyle(1, 0x222222);
    for (var x = 0; x <= 800; x += 50) { wchntGraphics.drawLine(x, 0, x, 600); }
    for (var y = 0; y <= 600; y += 50) { wchntGraphics.drawLine(0, y, 800, y); }
    wchntGraphics.noStroke();
    drawHud();
}

%step
function step() {
    wall.inbox.inject(wchntInput.keyPresses());
    var mx = wchntInput.mouseX();
    var my = wchntInput.mouseY();
    var udx = (wchntInput.keyDown("ArrowRight") ? 4.0 : 0.0) - (wchntInput.keyDown("ArrowLeft") ? 4.0 : 0.0);
    var udy = (wchntInput.keyDown("ArrowDown") ? 4.0 : 0.0) - (wchntInput.keyDown("ArrowUp") ? 4.0 : 0.0);
    var old = wall;
    var next = wall.step(mx, my, udx, udy);
    for (var i = 0; i < old.flies.length; i++) {
        var f = old.flies[i];
        var g = next.flies[i];
        wchntGraphics.lineStyle(1, colors[f.col]);
        wchntGraphics.drawLine(f.x, f.y, g.x, g.y);
    }
    wall = next;
    if (wall.aliveCount() < 2) {
        wchntGraphics.clear();
        wall = WallAssemblage.factory(wchntMaths).init();
    }
    drawHud();
}
```
