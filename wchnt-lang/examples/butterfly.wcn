# Butterfly Painting

Like [[paint]] but symmetrical.

The brush paints both where the brush is, and the "reflection" around the central y-axis.


As with the original paint, keys **1–9** pick the colour (1 black, 2 red, 3 green,
4 blue, 5 yellow, 6 magenta, 7 cyan, 8 orange, 9 white).

Notice here we've made the Brush a context-dependent component of the Paint. That gives it access, via thePaint, to the Canvas and canvas.width


## Schema

```
Paint = Canvas :Brush Palette Input
Canvas = Int/width Int/height
Brush = Int/x Int/y Int/rad Colour Bool/painting
Colour = "Black" | "White" | "Red" | "Green" | "Blue" | "Yellow" | "Cyan" | "Magenta" | "Orange"
Palette = {Colour:Int}
>Input = Int/mouseX Int/mouseY Bool/down Int/key
```

## Construction

```
[:Paint
  [:Canvas 800 600]
  [:Brush 0 0 5 Black false]  
  [:Palette
    {Colour:Int
      Black:   0xFF000000
      White:   0xFFFFFFFF
      Red:     0xFFFF0000
      Green:   0xFF00FF00
      Blue:    0xFF0000FF
      Yellow:  0xFFFFFF00
      Magenta: 0xFFFF00FF
      Cyan:    0xFF00FFFF
      Orange:  0xFFFF8000
    }
  ]
  [:Input 0 0 false 0]
]
```

## Methods

```
Paint::step = {
  key = input.key.
  nextColour = if (key == 0) { brush.colour } else { palette.colourForKey(key) }.
  nextBrush = [:Brush input.mouseX input.mouseY brush.rad nextColour input.down].
  [:Paint canvas nextBrush palette input]
}

Input::update! = { [:Input mouseX mouseY down key] }

Palette::colourForKey = { Int/key |
  switch (key)
    1 -> { Black }
    2 -> { Red }
    3 -> { Green }
    4 -> { Blue }
    5 -> { Yellow }
    6 -> { Magenta }
    7 -> { Cyan }
    8 -> { Orange }
    else -> { White }
}

Brush::paint = { @WCHNTGraphics/g |
  col = thePaint.palette.colourToInt.get(colour).
  if (painting) {
    g.beginFill(col)
      .drawCircle(x, y, rad)
      .drawCircle((thePaint.canvas.width-x), y, rad)
      .endFill()
   } else { g }
}

Canvas::paint = { @WCHNTGraphics/g |
  g.beginFill(0xFFFFFFFF).drawRect(0, 0, width, height).endFill()
}
```

## Target

```
%openfl

%init
var assemblage:Paint;
var down:Map<Int, Bool> = new Map();
var pointerX:Int = 0;
var pointerY:Int = 0;
var mouseDown:Bool = false;

function init():Void {
    assemblage = PaintAssemblage.factory();
    assemblage.canvas.paint(wchntGraphics);
    stage.addEventListener(KeyboardEvent.KEY_DOWN, function(e:KeyboardEvent) {
        down.set(e.keyCode, true);
    });
    stage.addEventListener(KeyboardEvent.KEY_UP, function(e:KeyboardEvent) {
        down.set(e.keyCode, false);
    });
    stage.addEventListener(MouseEvent.MOUSE_MOVE, function(e:MouseEvent) {
        pointerX = Std.int(e.stageX);
        pointerY = Std.int(e.stageY);
    });
    stage.addEventListener(MouseEvent.MOUSE_DOWN, function(e:MouseEvent) {
        pointerX = Std.int(e.stageX);
        pointerY = Std.int(e.stageY);
        mouseDown = true;
    });
    stage.addEventListener(MouseEvent.MOUSE_UP, function(e:MouseEvent) {
        pointerX = Std.int(e.stageX);
        pointerY = Std.int(e.stageY);
        mouseDown = false;
    });
}

function held(code:Int):Bool {
    return down.exists(code) && down.get(code);
}

function digit():Int {
    for (n in 1...10) {
        if (held(Keyboard.NUMBER_1 + n - 1)) return n;
    }
    return 0;
}

%step
function step():Void {
    assemblage.input.inject(pointerX, pointerY, mouseDown, digit());
    assemblage = assemblage.step();
    assemblage.brush.paint(wchntGraphics);
}
```
