# Pong (OpenFL)

Player vs computer. **`Rect = PlayArea | Paddle`** — bounds and paddles share a sum type. **`$Time`** + **`>Keys`** inject-then-tick. **`:Ball`** reads **`theGame.playArea`** via context.

## Schema

```
>Keys = Bool/left Bool/right Bool/up Bool/down
Game = PlayArea :Ball Paddle/paddlePlayer Paddle/paddleAi Int/playerScore Int/aiScore $Time Keys
Rect = PlayArea | Paddle
PlayArea = Int/x Int/y Int/width Int/height
Ball = Int/x Int/y Int/dx Int/dy Int/rad
Paddle = Int/x Int/y Int/h Int/w
Time = Int/t
```

## Construction

```
[:Game
  [:PlayArea 0 0 800 600]
  [:Ball 400 300 5 4 10]
  [:Paddle 24 250 100 14]
  [:Paddle 762 250 100 14]
  0
  0
  [:Time 0]
  [:Keys false false false false]
]
```

## Methods

```
Time::update! = { [:Time (t + 1)] }

Keys::update! = { [:Keys left right up down] }

PlayArea::paddleMaxY = { Int/paddleH | ((y + height) - paddleH) }

PlayArea::scoreSide = { Int/ballX |
  if (ballX < x) { 2 } (ballX > (x + width)) { 1 } else { 0 }
}

PlayArea::centerBall = { Int/toDx |
  [:Ball (x + (width / 2)) (y + (height / 2)) toDx 4 10]
}

PlayArea::ballAfterScore = { Int/scored, Ball/b |
  switch (scored)
    1 -> { this.centerBall(-5) }
    2 -> { this.centerBall(5) }
    else -> { b }
}

Ball::bounceDy = {
  ny = (y + dy).
  top = theGame.playArea.y.
  bottom = (theGame.playArea.y + theGame.playArea.height).
  if ((ny - rad) < top) { -dy } ((ny + rad) > bottom) { -dy } else { dy }
}

Ball::withDy = {
  ndy = this.bounceDy().
  [:Ball x (y + ndy) dx ndy rad]
}

Ball::withDx = { Int/ndx |
  [:Ball (x + ndx) y ndx dy rad]
}

Ball::withPaddleBounce = { Bool/hitPlayer, Bool/hitAi |
  ndx = dx.
  ndx2 = if (hitPlayer) {
    if (ndx < 0) { -(ndx) } else { ndx }
  } (hitAi) {
    if (ndx > 0) { -(ndx) } else { ndx }
  } else {
    ndx
  }.
  this.withDx(ndx2)
}

Paddle::moveY = { Int/dy, Int/minY, Int/maxY |
  ny = (y + dy).
  fy = if (ny < minY) { minY } (ny > maxY) { maxY } else { ny }.
  [:Paddle x fy h w]
}

Paddle::stepForPlayer = { Bool/up, Bool/down, PlayArea/area |
  dy = (if (up) { -8 } else { 0 }) + (if (down) { 8 } else { 0 }).
  this.moveY(dy, area.y, area.paddleMaxY(h))
}

Paddle::stepForAi = { Ball/b, PlayArea/area |
  center = (y + (h / 2)).
  dy = if (center < b.y) { 5 } (center > b.y) { -5 } else { 0 }.
  this.moveY(dy, area.y, area.paddleMaxY(h))
}

Paddle::hitsBall = { Ball/b |
  (b.x + b.rad > x) and (b.x - b.rad < (x + w)) and (b.y + b.rad > y) and (b.y - b.rad < (y + h))
}

Game::update! = {
  p1 = paddlePlayer.stepForPlayer(keys.up, keys.down, playArea).
  p2 = paddleAi.stepForAi(ball, playArea).
  b1 = ball.withDy().
  scored = playArea.scoreSide((b1.x + b1.dx)).
  hitP = if (scored == 0) { p1.hitsBall(b1) } else { false }.
  hitA = if ((scored == 0) and (not hitP)) { p2.hitsBall(b1) } else { false }.
  nextBall = playArea.ballAfterScore(scored, b1.withPaddleBounce(hitP, hitA)).
  nextPlayerScore = if (scored == 1) { (playerScore + 1) } else { playerScore }.
  nextAiScore = if (scored == 2) { (aiScore + 1) } else { aiScore }.
  [:Game playArea nextBall p1 p2 nextPlayerScore nextAiScore time keys]
}

Game::draw = { @WCHNTGraphics/g |
  g.clear().beginFill(0x1a1a2e).drawRect(playArea.x, playArea.y, playArea.width, playArea.height).endFill().beginFill(0xe8e8e8).drawRect(paddlePlayer.x, paddlePlayer.y, paddlePlayer.w, paddlePlayer.h).drawRect(paddleAi.x, paddleAi.y, paddleAi.w, paddleAi.h).drawCircle(ball.x, ball.y, ball.rad).endFill().fillText("You " + playerScore.str() + "  AI " + aiScore.str(), 12, 12)
}
```

## Target

```
%openfl

%init
var game:Game;

function init():Void {
    game = GameAssemblage.factory();
}

%step
function step():Void {
    game.keys.inject(wchntInput.keyDown("ArrowLeft"), wchntInput.keyDown("ArrowRight"), wchntInput.keyDown("ArrowUp"), wchntInput.keyDown("ArrowDown"));
    game.time.update_mutates();
    game.draw(wchntGraphics);
}
```
